# AI-Stylist Backend Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/aistyle
DB_USERNAME=aistyle_user
DB_PASSWORD=your_secure_database_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_at_least_32_chars
JWT_EXPIRATION=86400000

# Hugging Face API Configuration
HF_API_TOKEN=hf_your_hugging_face_api_token_here

# Server Configuration
SERVER_PORT=8080

# Logging
LOGGING_LEVEL=INFO
