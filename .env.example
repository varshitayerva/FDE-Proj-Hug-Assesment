# HuggingFace API Configuration
# ============================
# IMPORTANT: This file shows what environment variables are needed.
# DO NOT commit actual API keys to version control.
#
# Set these environment variables before running the application:
#
# Windows (Command Prompt):
#   set HF_API_TOKEN=your_token_here
#
# Windows (PowerShell):
#   $env:HF_API_TOKEN="your_token_here"
#
# macOS/Linux:
#   export HF_API_TOKEN=your_token_here

# Required environment variables:
HF_API_TOKEN=your_hugging_face_api_token_here

# Optional: For production deployments, you might want to configure:
# HF_API_URL=https://router.huggingface.co/v1  (default)
# LOG_LEVEL=INFO  (default is DEBUG)
